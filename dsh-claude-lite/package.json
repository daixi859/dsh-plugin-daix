{
  "name": "dsh-claude-lite",
  "version": "0.1.0",
  "description": "Claude Code 风格的轻量皮肤：只重绘侧边栏，并把对话区标题与视图页签抬进系统标题栏；对话区与输入区保持宿主原样。",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "戴曦 (Nwflower)",
  "main": "lib/host/index.js",
  "exports": {
    ".": "./lib/host/index.js",
    "./client": "./lib/client.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "dsh": {
    "engines": ">=0.1.7",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "skin.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
