{
  "name": "dsh-claude-shell",
  "description": "Claude-style shell for DeepSeek Harness — the sidebar, the view tabs and the title-bar band; composer and conversation stay native",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/host/index.js",
  "icon": "lib/claude-mark.svg",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "exports": {
    ".": "./lib/host/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.7"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "locale",
    "skin.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "web-ui",
    "theme",
    "claude",
    "claude-code",
    "sidebar",
    "titlebar"
  ],
  "license": "MIT",
  "author": "Nwflower",
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-alpha.1",
    "@types/node": "^26.6.4",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitest/browser-playwright": "^5.0.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "playwright": "^1.63.0",
    "postcss": "8.5.29",
    "postcss-selector-parser": "7.1.6",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
