{
  "name": "dsh-css-override",
  "version": "1.0.0",
  "private": true,
  "description": "CSS 覆盖器：在设置里维护多条 CSS 规则，勾选启用的规则以 <style> 注入到 body 覆盖应用样式，规则落盘持久化",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "css",
    "override",
    "theme",
    "settings"
  ],
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT"
}
