{
  "name": "dsh-vision-suite",
  "description": "Image recognition suite for DeepSeek Harness: a model-facing recognize_image tool over an OpenAI-compatible vision API, plus composer paste/drop-to-path (pasted images and dropped files save to a temp file and insert their paths instead of attachments)",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "vision",
    "ocr",
    "clipboard"
  ],
  "license": "MIT"
}
